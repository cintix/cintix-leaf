@using Leaf.Web.Features.Shared.Models
@model Leaf.Web.UI.Models.Dashboard.DashboardPageViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="dashboard-grid">
    <article class="card hero-card">
        <h2>@Model.Snapshot.ProjectName</h2>
        <p>@(Model.Snapshot.ActiveSprint is null ? "No active sprint" : $"{Model.Snapshot.ActiveSprint.Name}: {Model.Snapshot.ActiveSprint.Goal}")</p>
        @if (Model.Snapshot.ActiveSprint is not null)
        {
            <div class="pill-row">
                <span class="pill">@Model.Snapshot.ActiveSprint.StartDate - @Model.Snapshot.ActiveSprint.EndDate</span>
                <span class="pill">Planned @Model.Snapshot.ActiveSprint.PlannedStoryPoints pts</span>
                <span class="pill">Completed @Model.Snapshot.ActiveSprint.CompletedStoryPoints pts</span>
            </div>
        }
        <div class="action-row">
            <a class="leaf-button" href="/projects/@Model.Snapshot.ProjectKey">Open project workspace</a>
        </div>
    </article>

    <article class="card status-card">
        <h3>Tasks by status</h3>
        <div class="status-bars">
            @foreach (var status in Enum.GetValues<WorkItemStatus>())
            {
                var count = Model.Snapshot.CountsByStatus.TryGetValue(status, out var value) ? value : 0;
                <div class="status-row">
                    <span>@status</span>
                    <strong>@count</strong>
                </div>
            }
        </div>
    </article>

    <article class="card">
        <h3>My assigned tasks</h3>
        @if (Model.Snapshot.MyItems.Count == 0)
        {
            <p class="muted">No assigned items.</p>
        }
        else
        {
            <ul class="flat-list">
                @foreach (var item in Model.Snapshot.MyItems)
                {
                    <li><strong>@item.Title</strong> <span class="muted">@item.Status · @item.StoryPoints pts</span></li>
                }
            </ul>
        }
    </article>

    <article class="card">
        <h3>Overdue items</h3>
        @if (Model.Snapshot.OverdueItems.Count == 0)
        {
            <p class="muted">No overdue items.</p>
        }
        else
        {
            <ul class="flat-list">
                @foreach (var item in Model.Snapshot.OverdueItems)
                {
                    <li><strong>@item.Title</strong> <span class="muted">Due @item.DueDate</span></li>
                }
            </ul>
        }
    </article>

    <article class="card wide">
        <h3>Recent activity</h3>
        @if (Model.Snapshot.RecentActivity.Count == 0)
        {
            <p class="muted">No recent events.</p>
        }
        else
        {
            <ul class="activity-list">
                @foreach (var entry in Model.Snapshot.RecentActivity)
                {
                    <li>
                        <span>@entry.Description</span>
                        <small>@entry.CreatedUtc.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                    </li>
                }
            </ul>
        }
    </article>
</div>
