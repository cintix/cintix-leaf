@using Leaf.Features.Shared.Models
@model Leaf.Web.Models.Projects.ProjectWorkspaceViewModel
@{
    ViewData["Title"] = $"{Model.Project.Key} workspace";

    var groups = Model.BoardItems
        .GroupBy(x => x.Status)
        .ToDictionary(x => x.Key, x => x.OrderBy(i => i.ColumnOrder).ToList());
}
<div class="workspace" data-project-id="@Model.Project.Id">
    <section class="card workspace-header">
        <div>
            <h2>@Model.Project.Key · @Model.Project.Name</h2>
            <p>@Model.Project.Description</p>
        </div>
        <div class="pill-row">
            @if (Model.ActiveSprint is not null)
            {
                <span class="pill accent">Active sprint: @Model.ActiveSprint.Name</span>
            }
            else
            {
                <span class="pill">No active sprint</span>
            }
            <span class="pill">Members: @Model.Members.Count</span>
            <span class="pill">Backlog: @Model.Backlog.Count items</span>
        </div>
    </section>

    <section class="card">
        <div class="toolbar">
            <form method="get" class="filters" asp-action="Workspace" asp-route-id="@Model.Project.Id">
                <input type="text" class="leaf-input compact" name="q" placeholder="Search work items" value="@Model.Query" />
                <select class="leaf-input compact" name="assigneeId">
                    <option value="">All assignees</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id" selected="@(Model.AssigneeFilter == user.Id)">@user.DisplayName</option>
                    }
                </select>
                <select class="leaf-input compact" name="sprintId">
                    <option value="">All sprints</option>
                    @foreach (var sprint in Model.Sprints)
                    {
                        <option value="@sprint.Id" selected="@(Model.SprintFilter == sprint.Id)">@sprint.Name</option>
                    }
                </select>
                <select class="leaf-input compact" name="label">
                    <option value="">All labels</option>
                    @foreach (var l in Model.Labels)
                    {
                        <option value="@l.Name" selected="@(Model.LabelFilter == l.Name)">@l.Name</option>
                    }
                </select>
                <button type="submit" class="leaf-button ghost">Filter</button>
            </form>
        </div>

        <div class="quick-create">
            <h3>Quick create item</h3>
            <form id="quickCreateForm" class="quick-form">
                <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
                <input class="leaf-input" name="Title" placeholder="Work item title" required />
                <input class="leaf-input" name="Description" placeholder="Description" />
                <select class="leaf-input" name="Type">
                    <option value="2">Story</option>
                    <option value="3">Task</option>
                    <option value="4">Bug</option>
                    <option value="1">Epic</option>
                    <option value="5">Subtask</option>
                </select>
                <select class="leaf-input" name="Priority">
                    <option value="2">Medium</option>
                    <option value="1">Low</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>
                </select>
                <select class="leaf-input" name="AssigneeUserId">
                    <option value="">Unassigned</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </select>
                <input class="leaf-input" name="StoryPoints" type="number" min="0" value="1" />
                <input class="leaf-input" name="Labels" placeholder="labels,comma,separated" />
                <button class="leaf-button" type="submit">Create</button>
            </form>
        </div>
    </section>

    <section class="card">
        <div class="toolbar split">
            <h3>Backlog</h3>
            <div class="toolbar-actions">
                <select id="bulkSprintSelect" class="leaf-input compact">
                    <option value="">Move selected to sprint...</option>
                    @foreach (var sprint in Model.Sprints.Where(s => s.State != SprintState.Closed))
                    {
                        <option value="@sprint.Id">@sprint.Name</option>
                    }
                </select>
                <button id="bulkMoveBtn" class="leaf-button ghost" type="button">Move selected</button>
            </div>
        </div>

        <div class="table-wrap">
            <table class="leaf-table" id="backlogTable" data-project-id="@Model.Project.Id">
                <thead>
                    <tr>
                        <th></th>
                        <th>Item</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Assignee</th>
                        <th>Priority</th>
                        <th>Points</th>
                        <th>Labels</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Backlog)
                    {
                        var assignee = Model.Users.FirstOrDefault(u => u.Id == item.AssigneeUserId)?.DisplayName ?? "Unassigned";
                        <tr class="backlog-row" draggable="true" data-item-id="@item.Id">
                            <td><input type="checkbox" class="bulk-check" value="@item.Id" /></td>
                            <td><strong>@item.Title</strong><small>@item.Description</small></td>
                            <td>@item.Type</td>
                            <td><span class="status-tag s-@((int)item.Status)">@item.Status</span></td>
                            <td>@assignee</td>
                            <td>@item.Priority</td>
                            <td>@item.StoryPoints</td>
                            <td>
                                <div class="label-stack">
                                    @foreach (var label in item.LabelsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        var style = Model.Labels.FirstOrDefault(x => x.Name.Equals(label, StringComparison.OrdinalIgnoreCase))?.ColorHex ?? "#92A09A";
                                        <span class="label" style="--label-color:@style">@label</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card">
        <div class="toolbar split">
            <h3>Active sprint board</h3>
            <div class="toolbar-actions">
                <button class="leaf-button ghost" type="button" id="openSprintModal">Plan sprint</button>
            </div>
        </div>

        <div class="board" data-sprint-id="@(Model.ActiveSprint?.Id)">
            @foreach (var status in Enum.GetValues<WorkItemStatus>())
            {
                groups.TryGetValue(status, out var items);
                <div class="board-column" data-status="@((int)status)">
                    <header>
                        <h4>@status</h4>
                        <small>@(items?.Count ?? 0)</small>
                    </header>
                    <div class="board-dropzone">
                        @if (items is not null)
                        {
                            foreach (var item in items)
                            {
                                var assignee = Model.Users.FirstOrDefault(u => u.Id == item.AssigneeUserId)?.DisplayName ?? "Unassigned";
                                <article class="board-card" draggable="true" data-item-id="@item.Id">
                                    <h5>@item.Title</h5>
                                    <p>@item.Description</p>
                                    <div class="meta-row">
                                        <span>@assignee</span>
                                        <span>@item.Priority</span>
                                        <span>@item.StoryPoints pts</span>
                                    </div>
                                    <div class="label-stack">
                                        @foreach (var label in item.LabelsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            var style = Model.Labels.FirstOrDefault(x => x.Name.Equals(label, StringComparison.OrdinalIgnoreCase))?.ColorHex ?? "#92A09A";
                                            <span class="label" style="--label-color:@style">@label</span>
                                        }
                                    </div>
                                </article>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="grid two">
        <article class="card">
            <h3>Sprints</h3>
            <ul class="flat-list">
                @foreach (var sprint in Model.Sprints)
                {
                    <li class="sprint-row">
                        <div>
                            <strong>@sprint.Name</strong>
                            <small>@sprint.StartDate - @sprint.EndDate · @sprint.State</small>
                        </div>
                        <div class="inline-buttons">
                            @if (sprint.State == SprintState.Planned)
                            {
                                <button class="leaf-button ghost sprint-start" data-sprint-id="@sprint.Id" type="button">Start</button>
                            }
                            @if (sprint.State == SprintState.Active)
                            {
                                <button class="leaf-button ghost sprint-close" data-sprint-id="@sprint.Id" type="button">Close</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </article>

        <article class="card" id="reportsPanel" data-project-id="@Model.Project.Id">
            <h3>Reports</h3>
            <div class="report-block">
                <h4>Burndown</h4>
                <div id="burndownChart" class="chart"></div>
            </div>
            <div class="report-block">
                <h4>Velocity</h4>
                <div id="velocityChart" class="chart"></div>
            </div>
            <div class="report-block">
                <h4>Throughput</h4>
                <p id="throughputText" class="muted">Loading...</p>
            </div>
        </article>
    </section>

    <section class="card">
        <h3>Activity history</h3>
        <ul class="activity-list">
            @foreach (var eventItem in Model.Activity)
            {
                <li>
                    <span>@eventItem.Description</span>
                    <small>@eventItem.CreatedUtc.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                </li>
            }
        </ul>
    </section>

    <section class="card">
        <h3>Project members</h3>
        <form method="post" asp-action="UpdateMembers" asp-route-id="@Model.Project.Id">
            @Html.AntiForgeryToken()
            <div class="member-grid">
                @foreach (var user in Model.Users)
                {
                    var selected = Model.Members.Any(x => x.Id == user.Id);
                    <label class="member-option">
                        <input type="checkbox" name="memberUserIds" value="@user.Id" checked="@selected" />
                        <span>@user.DisplayName</span>
                    </label>
                }
            </div>
            <button class="leaf-button ghost" type="submit">Update members</button>
        </form>
    </section>
</div>

<div class="modal" id="sprintModal" hidden>
    <div class="modal-card">
        <header>
            <h4>Create sprint</h4>
            <button type="button" class="icon-btn" data-close-modal="#sprintModal">x</button>
        </header>
        <form id="createSprintForm" class="stack-form">
            <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
            <label>Name
                <input class="leaf-input" name="Name" required placeholder="Sprint 15" />
            </label>
            <label>Goal
                <textarea class="leaf-input" name="Goal" rows="2"></textarea>
            </label>
            <label>Capacity note
                <input class="leaf-input" name="CapacityNote" placeholder="Team capacity: 36 points" />
            </label>
            <div class="inline-grid">
                <label>Start date
                    <input class="leaf-input" type="date" name="StartDate" required value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" />
                </label>
                <label>End date
                    <input class="leaf-input" type="date" name="EndDate" required value="@DateOnly.FromDateTime(DateTime.Today.AddDays(14)).ToString("yyyy-MM-dd")" />
                </label>
            </div>
            <label>Include backlog items (comma-separated ids)
                <input class="leaf-input" name="WorkItemIds" placeholder="12,13,14" />
            </label>
            <button class="leaf-button" type="submit">Create sprint</button>
        </form>
    </div>
</div>
